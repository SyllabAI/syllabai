  {
   "id": "34157e0b-52e5-4e92-975a-b9dc9bcea4bb",
   "marks": 12,
   "state": "SUGGESTED",
   "qnum": null,
   "stem_len": 520,
   "stem": "A student uses this apparatus to investigate the rate of reaction between magnesium and an excess of dilute hydrochloric acid. She uses this method. use a graduated beaker to pour $ 50 \\mathrm{c m}^{3} $ of dilute hydrochloric acid of concentration 2.00 mol/dm $ ^{3} $ into the conical flask add a piece of magnesium ribbon of mass 0.086 g to the acid and put the bung into the neck of the flask mea"
