digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.35, ranksep=0.8, pad=0.25, bgcolor="white", fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica"];
  edge [color="#555555", penwidth=1.0, arrowsize=0.7, fontname="Helvetica", fontsize=9];
  user [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#dbe8f8"><B>USER</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> user_id</TD></TR><TR><TD ALIGN="LEFT">email / display_name / enabled</TD></TR></TABLE>>];
  student_profile [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e5f4e5"><B>STUDENT_PROFILE</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK/FK</B> user_id</TD></TR></TABLE>>];
  teacher_profile [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#fff1dc"><B>TEACHER_PROFILE</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK/FK</B> user_id</TD></TR></TABLE>>];
  admin_profile [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f1e6f8"><B>ADMIN_PROFILE</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK/FK</B> user_id</TD></TR></TABLE>>];
  board [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e8f3e8"><B>BOARD</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> board_id</TD></TR><TR><TD ALIGN="LEFT">name / code</TD></TR></TABLE>>];
  qualification [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e8f3e8"><B>QUALIFICATION</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> qualification_id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> board_id</TD></TR><TR><TD ALIGN="LEFT">name / code</TD></TR></TABLE>>];
  subject [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e8f3e8"><B>SUBJECT</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> subject_id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> qualification_id</TD></TR><TR><TD ALIGN="LEFT">name / code</TD></TR></TABLE>>];
  curriculum_version [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e8f3e8"><B>CURRICULUM_VERSION</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> curriculum_version_id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> subject_id</TD></TR><TR><TD ALIGN="LEFT">version / status / provenance</TD></TR></TABLE>>];
  enrollment [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e5f4e5"><B>SUBJECT_ENROLLMENT</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> enrollment_id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> student_id / curriculum_version_id</TD></TR><TR><TD ALIGN="LEFT">status / joined_at</TD></TR></TABLE>>];
  curriculum_node [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#dff1df"><B>CURRICULUM_NODE</B> <I>(supertype)</I></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> node_id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> curriculum_version_id</TD></TR><TR><TD ALIGN="LEFT">code / title / validation / provenance</TD></TR></TABLE>>];
  unit [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD><B>UNIT / SECTION</B></TD></TR><TR><TD><B>PK/FK</B> node_id</TD></TR></TABLE>>];
  topic [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD><B>TOPIC</B></TD></TR><TR><TD><B>PK/FK</B> node_id</TD></TR></TABLE>>];
  subtopic [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD><B>SUBTOPIC</B></TD></TR><TR><TD><B>PK/FK</B> node_id</TD></TR></TABLE>>];
  specpoint [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#d0efd0"><B>SPECIFICATION_POINT</B></TD></TR><TR><TD><B>PK/FK</B> node_id</TD></TR><TR><TD>official_code / verbatim_objective</TD></TR><TR><TD>applicability / source provenance</TD></TR></TABLE>>];
  concept [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD><B>CONCEPT</B></TD></TR><TR><TD><B>PK/FK</B> node_id</TD></TR></TABLE>>];
  misconception [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#fce4e4"><B>MISCONCEPTION</B></TD></TR><TR><TD><B>PK/FK</B> node_id</TD></TR></TABLE>>];
  knowledge_relation [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#dff1df"><B>KNOWLEDGE_RELATION</B></TD></TR><TR><TD><B>PK</B> relation_id</TD></TR><TR><TD><B>FK</B> source_node_id / target_node_id</TD></TR><TR><TD>relation / confidence / provenance</TD></TR></TABLE>>];
  resource [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#fff1dc"><B>LEARNING_RESOURCE</B> <I>(supertype)</I></TD></TR><TR><TD><B>PK</B> resource_id</TD></TR><TR><TD>title / provenance / validation</TD></TR></TABLE>>];
  revision_note [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD><B>REVISION_NOTE</B></TD></TR><TR><TD><B>PK/FK</B> resource_id</TD></TR></TABLE>>];
  flashcard [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD><B>FLASHCARD</B></TD></TR><TR><TD><B>PK/FK</B> resource_id</TD></TR></TABLE>>];
  smart_lesson_step [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD><B>SMART_LESSON_STEP</B></TD></TR><TR><TD><B>PK/FK</B> resource_id</TD></TR><TR><TD>sequence / adaptive policy</TD></TR></TABLE>>];
  resource_spec [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD><B>RESOURCE_SPEC_POINT</B></TD></TR><TR><TD><B>PK</B> mapping_id</TD></TR><TR><TD><B>FK</B> resource_id / spec_point_id</TD></TR><TR><TD>confidence / provenance / validation</TD></TR></TABLE>>];
  exam_paper [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f3e8f5"><B>EXAM_PAPER</B></TD></TR><TR><TD><B>PK</B> paper_id</TD></TR><TR><TD><B>FK</B> curriculum_version / subject</TD></TR><TR><TD>paper_code / session / validation</TD></TR></TABLE>>];
  question [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f3e8f5"><B>QUESTION</B></TD></TR><TR><TD><B>PK</B> question_id</TD></TR><TR><TD><B>FK</B> paper_id</TD></TR><TR><TD>type / provenance</TD></TR></TABLE>>];
  question_version [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f3e8f5"><B>QUESTION_VERSION</B></TD></TR><TR><TD><B>PK</B> question_version_id</TD></TR><TR><TD><B>FK</B> question_id</TD></TR><TR><TD>version / stem / marks / validation</TD></TR></TABLE>>];
  question_part [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f3e8f5"><B>QUESTION_PART</B></TD></TR><TR><TD><B>PK</B> part_id</TD></TR><TR><TD><B>FK</B> question_version_id</TD></TR><TR><TD>label / prompt / marks</TD></TR></TABLE>>];
  q_spec [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD><B>QUESTION_SPEC_POINT</B></TD></TR><TR><TD><B>PK</B> mapping_id</TD></TR><TR><TD><B>FK</B> question_version/part / spec_point</TD></TR><TR><TD>confidence / provenance / validation</TD></TR></TABLE>>];
  mark_scheme [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f3e8f5"><B>MARK_SCHEME</B></TD></TR><TR><TD><B>PK</B> mark_scheme_id</TD></TR><TR><TD><B>FK</B> question_version_id</TD></TR><TR><TD>validation / source</TD></TR></TABLE>>];
  mark_point [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f3e8f5"><B>MARK_POINT</B></TD></TR><TR><TD><B>PK</B> mark_point_id</TD></TR><TR><TD><B>FK</B> scheme / part</TD></TR><TR><TD>marks / acceptance criteria</TD></TR></TABLE>>];
  attempt [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e7f5f4"><B>ATTEMPT</B></TD></TR><TR><TD><B>PK</B> attempt_id</TD></TR><TR><TD><B>FK</B> student_id / question</TD></TR><TR><TD>timed / confidence / response time</TD></TR><TR><TD>marking lifecycle / evidence guard</TD></TR></TABLE>>];
  answer [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e7f5f4"><B>ANSWER</B></TD></TR><TR><TD><B>PK</B> answer_id</TD></TR><TR><TD><B>FK</B> attempt_id / question_part_id</TD></TR><TR><TD>answer_text / marks</TD></TR></TABLE>>];
  smart_mark [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e7f5f4"><B>SMART_MARK_RESULT</B></TD></TR><TR><TD><B>PK</B> result_id</TD></TR><TR><TD><B>FK</B> answer_id</TD></TR><TR><TD>model / validation / breakdown</TD></TR></TABLE>>];
  human_mark [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e7f5f4"><B>HUMAN_MARK</B></TD></TR><TR><TD><B>PK</B> human_mark_id</TD></TR><TR><TD><B>FK</B> answer_id / marker_id</TD></TR><TR><TD>marks / point decisions</TD></TR></TABLE>>];
  kappa [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e7f5f4"><B>AGREEMENT_EVALUATION</B></TD></TR><TR><TD><B>PK</B> evaluation_id</TD></TR><TR><TD><B>FK</B> paper_id?</TD></TR><TR><TD>κ / threshold / passed</TD></TR></TABLE>>];
  skill_state [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#dff4e0"><B>SKILL_STATE</B></TD></TR><TR><TD><B>PK</B> skill_state_id</TD></TR><TR><TD><B>FK</B> student_id / node_id</TD></TR><TR><TD>BKT mastery / attempts / fluency gap</TD></TR></TABLE>>];
  misconception_state [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#fbe2e2"><B>MISCONCEPTION_STATE</B></TD></TR><TR><TD><B>PK</B> state_id</TD></TR><TR><TD><B>FK</B> student_id / misconception_id</TD></TR><TR><TD>probability / evidence</TD></TR></TABLE>>];
  review [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#dff4e0"><B>REVIEW_SCHEDULE</B></TD></TR><TR><TD><B>PK</B> review_id</TD></TR><TR><TD><B>FK</B> student_id / node_id</TD></TR><TR><TD>due_at / reason / status</TD></TR></TABLE>>];
  diagnosis [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#fbe9e9"><B>STRUGGLE_INFERENCE</B></TD></TR><TR><TD><B>PK</B> inference_id</TD></TR><TR><TD><B>FK</B> student_id / topic</TD></TR><TR><TD>type / subtype / probability</TD></TR></TABLE>>];
  document [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#fff0d8"><B>DOCUMENT</B></TD></TR><TR><TD><B>PK</B> document_id</TD></TR><TR><TD>kind / checksum / provenance</TD></TR></TABLE>>];
  chunk [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#fff0d8"><B>DOCUMENT_CHUNK</B></TD></TR><TR><TD><B>PK</B> chunk_id</TD></TR><TR><TD><B>FK</B> document_id</TD></TR><TR><TD>content / embedding</TD></TR></TABLE>>];
  telemetry [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#eee9f7"><B>TELEMETRY_EVENT</B></TD></TR><TR><TD><B>PK</B> event_id</TD></TR><TR><TD><B>FK</B> student_id</TD></TR><TR><TD>event_type / payload / occurred_at</TD></TR></TABLE>>];
  user -> student_profile [label="ISA",arrowhead=empty]; user -> teacher_profile [label="ISA",arrowhead=empty]; user -> admin_profile [label="ISA",arrowhead=empty];
  curriculum_node -> unit [label="ISA",arrowhead=empty]; curriculum_node -> topic [label="ISA",arrowhead=empty]; curriculum_node -> subtopic [label="ISA",arrowhead=empty]; curriculum_node -> specpoint [label="ISA",arrowhead=empty]; curriculum_node -> concept [label="ISA",arrowhead=empty]; curriculum_node -> misconception [label="ISA",arrowhead=empty];
  resource -> revision_note [label="ISA",arrowhead=empty]; resource -> flashcard [label="ISA",arrowhead=empty]; resource -> smart_lesson_step [label="ISA",arrowhead=empty];
  board -> qualification [label="1:N"]; qualification -> subject [label="1:N"]; subject -> curriculum_version [label="1:N"]; student_profile -> enrollment [label="1:N"]; curriculum_version -> enrollment [label="1:N"]; curriculum_version -> curriculum_node [label="1:N"]; curriculum_node -> knowledge_relation [label="1:N source/target",dir=both]; curriculum_node -> curriculum_node [label="PART_OF / prerequisite / related",style=dashed,dir=both];
  resource -> resource_spec [label="1:N"]; specpoint -> resource_spec [label="1:N"]; curriculum_version -> exam_paper [label="1:N"]; exam_paper -> question [label="1:N"]; question -> question_version [label="1:N"]; question_version -> question_part [label="1:N"]; question_version -> mark_scheme [label="1:N"]; mark_scheme -> mark_point [label="1:N"]; question_part -> mark_point [label="1:N optional"]; question_version -> q_spec [label="1:N"]; question_part -> q_spec [label="1:N optional"]; specpoint -> q_spec [label="1:N"]; student_profile -> attempt [label="1:N"]; question -> attempt [label="1:N"]; attempt -> answer [label="1:N"]; question_part -> answer [label="1:N"]; answer -> smart_mark [label="1:N append-only"]; answer -> human_mark [label="1:N append-only"]; exam_paper -> kappa [label="1:N optional"]; teacher_profile -> human_mark [label="1:N marker"]; student_profile -> skill_state [label="1:N"]; curriculum_node -> skill_state [label="1:N"]; student_profile -> misconception_state [label="1:N"]; misconception -> misconception_state [label="1:N"]; student_profile -> review [label="1:N"]; curriculum_node -> review [label="1:N"]; student_profile -> diagnosis [label="1:N"]; topic -> diagnosis [label="1:N"]; student_profile -> telemetry [label="1:N append-only"]; document -> chunk [label="1:N"]; document -> exam_paper [style=dashed,label="source document"]; document -> question_version [style=dashed,label="source"]; document -> mark_scheme [style=dashed,label="source"];
}
