digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.0, pad=0.25, bgcolor="white", fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica"];
  edge [color="#555555", penwidth=1.0, arrowsize=0.7, fontname="Helvetica", fontsize=9];
  roles [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e8eef7"><B>roles</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> name</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e8eef7"><B>users</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">email</TD></TR><TR><TD ALIGN="LEFT">display_name</TD></TR><TR><TD ALIGN="LEFT">enabled</TD></TR></TABLE>>];
  user_roles [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e8eef7"><B>user_roles</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK/FK</B> user_id</TD></TR><TR><TD ALIGN="LEFT"><B>PK/FK</B> role</TD></TR></TABLE>>];
  curriculum_versions [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e8f3e8"><B>curriculum_versions</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">board / qualification / code</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
  subjects [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e8f3e8"><B>subjects</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> curriculum_version_id</TD></TR><TR><TD ALIGN="LEFT">code / name</TD></TR></TABLE>>];
  knowledge_nodes [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e8f3e8"><B>knowledge_nodes</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">code / node_type / title</TD></TR><TR><TD ALIGN="LEFT">validation / provenance</TD></TR></TABLE>>];
  knowledge_edges [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e8f3e8"><B>knowledge_edges</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> source_node_id / target_node_id</TD></TR><TR><TD ALIGN="LEFT">relation_type / strength / provenance</TD></TR></TABLE>>];
  documents [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#fff1dd"><B>documents</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">document_id + version</TD></TR><TR><TD ALIGN="LEFT">kind / checksum / canonical_json</TD></TR></TABLE>>];
  document_chunks [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#fff1dd"><B>document_chunks</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> document_row_id</TD></TR><TR><TD ALIGN="LEFT">chunk_index / content / embedding</TD></TR></TABLE>>];
  exam_papers [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>exam_papers</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> subject_id</TD></TR><TR><TD ALIGN="LEFT">paper_code / session / validation</TD></TR></TABLE>>];
  questions [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>questions</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> exam_paper_id</TD></TR><TR><TD ALIGN="LEFT">type / stem / marks / difficulty</TD></TR></TABLE>>];
  question_versions [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>question_versions</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> question_id</TD></TR><TR><TD ALIGN="LEFT">version / validation / source</TD></TR></TABLE>>];
  question_parts [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>question_parts</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> question_version_id</TD></TR><TR><TD ALIGN="LEFT">label / prompt / marks</TD></TR></TABLE>>];
  question_topics [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>question_topics</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> question_id / node_id</TD></TR><TR><TD ALIGN="LEFT">is_primary</TD></TR></TABLE>>];
  question_options [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>question_options</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> question_id</TD></TR><TR><TD ALIGN="LEFT">label / option_text / misconception</TD></TR></TABLE>>];
  mark_schemes [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>mark_schemes</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> question_version_id</TD></TR><TR><TD ALIGN="LEFT">validation / source</TD></TR></TABLE>>];
  mark_points [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>mark_points</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> mark_scheme_id / part_id</TD></TR><TR><TD ALIGN="LEFT">ref / marks / criteria</TD></TR></TABLE>>];
  attempts [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>attempts</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> question_id; learner_id</TD></TR><TR><TD ALIGN="LEFT">correct / marks / timed / confidence</TD></TR><TR><TD ALIGN="LEFT">marking_state / evidence_emitted</TD></TR></TABLE>>];
  answers [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>answers</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> attempt_id / question_part_id</TD></TR><TR><TD ALIGN="LEFT">answer_text / marks / marking_state</TD></TR></TABLE>>];
  smart_mark_results [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>smart_mark_results</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> answer_id</TD></TR><TR><TD ALIGN="LEFT">pipeline / model / marks / validation</TD></TR></TABLE>>];
  human_marks [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>human_marks</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> answer_id</TD></TR><TR><TD ALIGN="LEFT">marker_id / marks / decisions</TD></TR></TABLE>>];
  smart_mark_agreement_evaluations [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f4e8f5"><B>smart_mark_agreement_evaluations</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> exam_paper_id?</TD></TR><TR><TD ALIGN="LEFT">scope / sample / kappa / passed</TD></TR></TABLE>>];
  skill_states [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e9f7f4"><B>skill_states</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">learner_id / <B>FK</B> node_id</TD></TR><TR><TD ALIGN="LEFT">mastery / attempts / fluency_gap / version</TD></TR></TABLE>>];
  misconception_states [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e9f7f4"><B>misconception_states</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">learner_id / <B>FK</B> misconception_node_id</TD></TR><TR><TD ALIGN="LEFT">probability / evidence / version</TD></TR></TABLE>>];
  review_schedules [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#e9f7f4"><B>review_schedules</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">learner_id / <B>FK</B> node_id</TD></TR><TR><TD ALIGN="LEFT">due_at / reason / status</TD></TR></TABLE>>];
  struggle_inferences [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#fcebea"><B>struggle_inferences</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> learner_id / topic_node_id</TD></TR><TR><TD ALIGN="LEFT">type / subtype / probability</TD></TR><TR><TD ALIGN="LEFT">expiry / superseded / override</TD></TR></TABLE>>];
  experiments [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#eee8fb"><B>experiments</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">experiment_key / status</TD></TR><TR><TD ALIGN="LEFT">pinned_provider / pinned_model / params</TD></TR></TABLE>>];
  model_versions [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#eee8fb"><B>model_versions</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">registry_key + version</TD></TR><TR><TD ALIGN="LEFT">params / provenance</TD></TR></TABLE>>];
  prompt_versions [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#eee8fb"><B>prompt_versions</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">registry_key + version</TD></TR><TR><TD ALIGN="LEFT">template / notes</TD></TR></TABLE>>];
  telemetry_events [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#eee8fb"><B>telemetry_events</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">learner_id / event_type</TD></TR><TR><TD ALIGN="LEFT">schema_version / payload / occurred_at</TD></TR></TABLE>>];
  glm_ocr_bridge_records [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f7eee5"><B>glm_ocr_bridge_records</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> paper_id</TD></TR><TR><TD ALIGN="LEFT">QP/MS identities / checksums</TD></TR><TR><TD ALIGN="LEFT">reconciliation / review JSONB</TD></TR></TABLE>>];
  teacher_validation_events [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f7eee5"><B>teacher_validation_events</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">importer_run_id / decision_seq+hash</TD></TR><TR><TD ALIGN="LEFT">target / action / result_state</TD></TR></TABLE>>];
  campaign_db_identity [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#f0f0f0"><B>campaign_db_identity</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id=1</TD></TR><TR><TD ALIGN="LEFT">campaign_label / db_name / host</TD></TR><TR><TD ALIGN="LEFT">core_commit / timestamps</TD></TR></TABLE>>];
  users -> user_roles [label="1:N"]; roles -> user_roles [label="1:N"];
  curriculum_versions -> subjects [label="1:N"]; subjects -> exam_papers [label="1:N"];
  subjects -> knowledge_nodes [style=dashed,label="subject root / logical"];
  knowledge_nodes -> knowledge_edges [label="1:N source/target",dir=both];
  documents -> document_chunks [label="1:N"];
  exam_papers -> questions [label="1:N"]; questions -> question_versions [label="1:N"]; questions -> question_topics [label="1:N"]; knowledge_nodes -> question_topics [label="1:N"]; questions -> question_options [label="1:N"];
  question_versions -> question_parts [label="1:N"]; question_versions -> mark_schemes [label="1:N"]; mark_schemes -> mark_points [label="1:N"]; question_parts -> mark_points [label="1:N optional"];
  questions -> attempts [label="1:N"]; attempts -> answers [label="1:N"]; question_parts -> answers [label="1:N"]; answers -> smart_mark_results [label="1:N"]; answers -> human_marks [label="1:N"]; exam_papers -> smart_mark_agreement_evaluations [label="1:N optional"];
  knowledge_nodes -> skill_states [label="1:N"]; knowledge_nodes -> misconception_states [label="1:N misconception"]; knowledge_nodes -> review_schedules [label="1:N"]; users -> attempts [style=dashed,label="learner_id"]; users -> skill_states [style=dashed,label="learner_id"]; users -> misconception_states [style=dashed,label="learner_id"]; users -> review_schedules [style=dashed,label="learner_id"]; users -> telemetry_events [style=dashed,label="learner_id"]; users -> struggle_inferences [label="1:N"]; knowledge_nodes -> struggle_inferences [label="1:N"];
  exam_papers -> glm_ocr_bridge_records [label="1:0..1"]; documents -> glm_ocr_bridge_records [style=dashed,label="document ids (logical)"]; users -> human_marks [style=dashed,label="marker_id"];
}
